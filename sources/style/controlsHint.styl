.controls-hint
    position fixed
    z-index 11
    left 50%
    bottom 2.2rem
    transform translateX(-50%)
    text-align center
    pointer-events none
    transition opacity 0.6s
    animation controls-hint-pulse 2.4s ease-in-out infinite

    &.is-hidden
        opacity 0

    .keys
        display flex
        flex-direction column
        align-items center
        gap 0.25rem

    .row
        display flex
        gap 0.25rem

    .key
        display flex
        align-items center
        justify-content center
        width 2rem
        height 2rem
        border-radius 0.35rem
        border 2px solid #8ee4ff
        color #8ee4ff
        font-size 0.85rem
        background rgba(20, 17, 32, 0.55)
        box-shadow 0 0 0.6rem rgba(142, 228, 255, 0.55), inset 0 0 0.4rem rgba(142, 228, 255, 0.3)

    .label
        margin-top 0.7rem
        color #8ee4ff
        font-size 0.9rem
        letter-spacing 0.06em
        text-shadow 0 0 0.7rem rgba(142, 228, 255, 0.7)

@keyframes controls-hint-pulse
    0%, 100%
        opacity 0.65
    50%
        opacity 1
