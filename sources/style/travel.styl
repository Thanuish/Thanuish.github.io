.travel
    position fixed
    z-index 12
    left 50%
    bottom 2rem
    transform translateX(-50%) translateY(1rem)
    opacity 0
    pointer-events none
    transition opacity 0.4s, transform 0.4s

    &.is-visible
        opacity 1
        transform translateX(-50%) translateY(0)
        pointer-events auto

    .inner
        background rgba(20, 17, 32, 0.92)
        border 1px solid rgba(255, 255, 255, 0.12)
        border-radius 0.8rem
        padding 1rem 1.2rem
        text-align center
        max-width calc(100vw - 3rem)
        backdrop-filter blur(6px)

    .title
        font-size 0.95rem
        margin-bottom 0.7rem
        opacity 0.9

    .modes,
    .destinations
        display flex
        flex-wrap wrap
        gap 0.5rem
        justify-content center

    .destinations
        display none
        margin-top 0.7rem

        &.is-visible
            display flex

    .button
        font-size 0.8rem
        padding 0.4rem 0.9rem

    .dismiss
        display block
        margin 0.7rem auto 0
        background none
        border 0
        color inherit
        opacity 0.45
        font-size 0.75rem
        cursor pointer
        font-family inherit

        &:hover
            opacity 0.8
